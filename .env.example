NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for production (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# GSA project ref (Dashboard → Project Settings → General) — npm run setup:supabase updates Cursor MCP
SUPABASE_PROJECT_REF=
# Postgres URI (Dashboard → Database → Connection string) — applies supabase/schema.sql
SUPABASE_DB_URL=
# Required in production (long random secret). Dev default: gsa-staff-2026
STAFF_TOKEN=
# Optional bubble goal for wall fill (default 20)
WALL_REVEAL_TARGET=20
